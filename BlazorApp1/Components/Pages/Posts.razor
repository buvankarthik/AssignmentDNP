@page "/posts"
@rendermode InteractiveServer
@inject IPostService PostService
@inject IUserService UserService

<h3>Posts</h3>
@if (error is not null) { <p>@error</p> }
<ul>
    @foreach (PostDto p in posts)
    {
        <li><a href="posts/@p.Id">@p.Title</a> by @AuthorName(p.UserId)</li>
    }
</ul>

@code {
    private List<PostDto> posts = new();
    private Dictionary<int, string> userNames = new();
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            posts = (await PostService.GetManyAsync()).ToList();
            userNames = (await UserService.GetManyAsync()).ToDictionary(u => u.Id, u => u.UserName);
        }
        catch (Exception e)
        {
            error = e.Message;
        }
    }

    private string AuthorName(int id) => userNames.TryGetValue(id, out string? name) ? name : "unknown";
}