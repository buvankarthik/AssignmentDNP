@page "/"
@inject NavigationManager NavMgr

<PageTitle>Home</PageTitle>

<h1>Hello!</h1>

<AuthorizeView>
    <Authorized>
        <p>Hello, @context.User.Identity?.Name</p>
    </Authorized>
    <NotAuthorized>
        <p>You are not logged in.</p>
        <button @onclick='() => NavMgr.NavigateTo("login")'>Go to login</button>
    </NotAuthorized>
</AuthorizeView>

Welcome to BIG BANG APP.