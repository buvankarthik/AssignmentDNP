@page "/posts/create"
@rendermode InteractiveServer
@inject IPostService PostService
@inject IUserService UserService

<h3>Create post</h3>
<div>
    <label>Author</label>
    <select @bind="userId">
        @foreach (UserDto u in users) { <option value="@u.Id">@u.UserName</option> }
    </select>
</div>
<div><label>Title</label> <input @bind="title" /></div>
<div><label>Body</label> <textarea @bind="body"></textarea></div>
<button class="btn btn-primary" @onclick="CreateAsync">Create</button>
@if (message is not null) { <p>@message</p> }

@code {
    private List<UserDto> users = new();
    private int userId;
    private string title = "";
    private string body = "";
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        users = (await UserService.GetManyAsync()).ToList();
        if (users.Count > 0) userId = users[0].Id;
    }

    private async Task CreateAsync()
    {
        try
        {
            PostDto created = await PostService.AddPostAsync(new CreatePostDto { Title = title, Body = body, UserId = userId });
            message = $"Post '{created.Title}' created";
            title = "";
            body = "";
        }
        catch (Exception e)
        {
            message = e.Message;
        }
    }
}