@page "/posts/create"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IPostService PostService

<h3>Create post</h3>
<div><label>Title</label> <input @bind="title" /></div>
<div><label>Body</label> <textarea @bind="body"></textarea></div>
<button class="btn btn-primary" @onclick="CreateAsync">Create</button>
@if (message is not null) { <p>@message</p> }

@code {
    [CascadingParameter] public Task<AuthenticationState> State { get; set; } = null!;

    private int userId;
    private string title = "";
    private string body = "";
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState authenticationState = await State;
        ClaimsPrincipal claimsPrincipal = authenticationState.User;
        userId = int.Parse(claimsPrincipal.Claims.Single(c => c.Type == "Id").Value);
    }

    private async Task CreateAsync()
    {
        try
        {
            PostDto created = await PostService.AddPostAsync(new CreatePostDto { Title = title, Body = body, UserId = userId });
            message = $"Post '{created.Title}' created";
            title = "";
            body = "";
        }
        catch (Exception e)
        {
            message = e.Message;
        }
    }
}